static float groimpLightInterception = 0;   // GroIMP三维光截获率 [0-1]
static float groimpInterceptedPAR = 0;   // GroIMP截获的PAR (MJ/m2/d)
static float[] groimpLayerLight = new float[CANOPY_LAYERS];   // 分层光截获
const float LAI_NUDGE_THRESHOLD = 0.15;   // 减少小偏差干扰
const float LAI_NUDGE_TAU = 6.0;
const float LAI_NUDGE_MAX_RATE = 0.20;   // 数值耦合收敛参数, 与 2025 实验组统一 (防止过冲)
static float c2k_sla_dynamic = 0.020;   // PLAN-B: 0.0012→0.020 m²/g

// Cotton2K 内部产量追踪 (接收自Socket/CSV, 用于双路径核算)
// 目的: 解决GroIMP结构路径(Gompertz铃重×密度)与C2K碳平衡路径(lint_yield)
// 存在+100%级别系统性差距的报告混乱问题
// 机制: GroIMP路径 = totalBollWeight×density×衣分 = "理论最大值"(无收获损耗)
// C2K路径 = lint_yield(kg/ha) = "碳平衡综合值"(含维持呼吸、效率损失等)
// 两路径差距≈50-130%是结构性差异,非参数错误
static float c2k_lint_yield_kgha = 0;   // C2K内部皮棉产量 (kg/ha), 来自Cotton2K lint_yield字段
static float c2k_seed_cotton_kgha = 0;   // C2K内部籽棉产量 (kg/ha), 来自seed_cotton_yield字段
// Milroy & Bange 2003 (棉花): 180-220 cm²/g = 0.018-0.022 m²/g
static float c2k_targetLeafAreaCm2 = 0;   // Cotton2K目标单株叶面积(cm²)，由CSV c2k_leaf_area_m2列×10000
static float c2k_leafAreaScale = 1.0f;   // 叶面积缩放因子 = 目标/当前，限幅[0.75, 2.0/3.0]: 下限0.5→0.75)
static float c2k_nudgeAmount = 0;   // 最近一次 nudge 的 Wleaf 调整量
static float c2k_cumulativeNudge = 0;   // 累积 nudge 量 (诊断)
static int   c2k_nudgeCount = 0;   // nudge 触发次数
// ====================================================================
// 【新增】Cotton2K CSV 数据桥接
// ====================================================================
static int COUPLING_MODE = 0;   // 0=内置求解器, 1=CSV读取
static java.util.ArrayList csvInputRows = new java.util.ArrayList();
static boolean csvLoaded = false;
static String csvInputPath = "c2k_input_for_groimp.csv";

// 逐日耦合通信变量
// ====================================================================
static Socket socketConn = null;
static BufferedReader socketIn = null;
static PrintWriter socketOut = null;
static boolean socketConnected = false;
static String socketHost = "127.0.0.1";
static int socketPort = 9527;
static java.util.HashMap currentDayData = null;

// 反馈数据收集
static java.util.ArrayList fbDay = new java.util.ArrayList();
static java.util.ArrayList fbDate = new java.util.ArrayList();
static java.util.ArrayList fbGroimpLAI = new java.util.ArrayList();
static java.util.ArrayList fbGroimpLI = new java.util.ArrayList();
static java.util.ArrayList fbGroimpPAR = new java.util.ArrayList();
static java.util.ArrayList fbPlantHeight = new java.util.ArrayList();
static java.util.ArrayList fbNLeaves = new java.util.ArrayList();
static java.util.ArrayList fbNActiveLeaves = new java.util.ArrayList();
static java.util.ArrayList fbSunPhoto = new java.util.ArrayList();
static java.util.ArrayList fbShadePhoto = new java.util.ArrayList();
static java.util.ArrayList fbTotalPhoto = new java.util.ArrayList();
static java.util.ArrayList[] fbLayerLight = new java.util.ArrayList[CANOPY_LAYERS];
static java.util.ArrayList[] fbLayerLAI_arr = new java.util.ArrayList[CANOPY_LAYERS];
// 逐日水分数据记录 (原代码用终态全局变量, 导致CSV所有行相同)
static java.util.ArrayList fbWaterStress = new java.util.ArrayList();
static java.util.ArrayList fbSoilWater = new java.util.ArrayList();
static String weatherCsvPath = "weather2022.csv";
static boolean weatherCsvLoaded = false;
static int weatherCsvStartOffset = 0;   // weather2022.csv 中 2022-05-01(出苗日) 对应的行索引
static float[] wxTmax = null;   // 日最高温 °C
static float[] wxTmin = null;   // 日最低温 °C
static float[] wxIrrad = null;   // 日总辐射 MJ/m²/d
static float[] wxRain = null;   // 降雨 mm
static float[] wxWind = null;   // 风速 m/s
static float[] wxTdew = null;   // 露点温度 °C
static float[] wxTavg = null;   // 日均气温 °C
static float[] wxRhAvg = null;   // 相对湿度 (小数 0-1)
static float[] wxDaylightSec = null;   // 白昼时长 (秒)
static float[] wxSunshineSec = null;   // 日照时长 (秒)
static int wxDays = 0;   // 加载的总天数
// 当日光合用日长 (秒)，优先来自 CSV/Socket 实测，其次天文计算
static float currentDaylightSec = 0.0f;

// 简易土壤水分模型 (滴灌条件)
// 灌溉参数修复 — 阿拉尔盛夏ETc≈7-8mm/d, 原3.6mm/d严重不足
// 实际滴灌制度: 5-7天一次, 每次40-50mm (棉花盛花铃期)
// 田间持水量: 阿拉尔砂壤土根区(0-60cm)约120-150mm
static float soilWaterContent = 100.0;   // 灌前充分灌溉
static float SOIL_WATER_CAPACITY = 140.0;   // 阿拉尔砂壤土实际容量
static float IRRIGATION_THRESHOLD = 60.0;   // 提早触发, 避免SWC归零
static float IRRIGATION_AMOUNT = 45.0;   // 匹配阿拉尔滴灌实际(40-50mm/次)
static int   IRRIGATION_INTERVAL = 5;   // 天 匹配盛夏高频灌溉
static int   lastIrrigationDay = 0;   // 上次灌溉天数
static float cumulativeET = 0;   // 累积蒸散 mm
static float cumulativeRain = 0;   // 累积降雨 mm
static float cumulativeIrrigation = 0;   // 累积灌溉 mm
static float safeParseFloat(String s, float def) {
    if (s == null) return def;
    s = s.trim();
    if (s.isEmpty()) return def;
    try { return Float.parseFloat(s); } catch (Exception e) { return def; }
}

static String normalizeDateStr(String s) {
    s = s.trim();
    // 增强日期格式兼容 (BOM清洗 + YYYYMMDD + 补零)
    if (s.startsWith("\uFEFF")) s = s.substring(1);
    // 格式 1: YYYY/M/D 或 YYYY/MM/DD
    if (s.indexOf('/') >= 0) {
        String[] p = s.split("/");
        if (p.length == 3) {
            return String.format("%04d-%02d-%02d",
                Integer.parseInt(p[0].trim()),
                Integer.parseInt(p[1].trim()),
                Integer.parseInt(p[2].trim()));
        }
    }
    // 格式 2: YYYYMMDD (8 位纯数字)
    if (s.length() == 8 && s.matches("\\d{8}")) {
        return s.substring(0, 4) + "-" + s.substring(4, 6) + "-" + s.substring(6, 8);
    }
    // 格式 3: 已是 YYYY-MM-DD (可能是 YYYY-M-D, 需补零)
    if (s.indexOf('-') >= 0) {
        String[] p = s.split("-");
        if (p.length == 3) {
            return String.format("%04d-%02d-%02d",
                Integer.parseInt(p[0].trim()),
                Integer.parseInt(p[1].trim()),
                Integer.parseInt(p[2].trim()));
        }
    }
    return s;   // 兜底原样返回
}

public void loadWeatherCSV() { loadWeatherCSV(weatherCsvPath); }

public void loadWeatherCSV(String path) {
    weatherCsvLoaded = false;
    try {
        java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(path));
        String headerLine = br.readLine();
        if (headerLine == null) { println(" [气象] 文件为空: " + path); return; }
        headerLine = headerLine.trim();
        if (headerLine.startsWith("\uFEFF")) headerLine = headerLine.substring(1);

        java.util.ArrayList rows = new java.util.ArrayList();
        String line;
        while ((line = br.readLine()) != null) {
            line = line.trim();
            if (line.isEmpty()) continue;
            rows.add(line.split(","));
        }
        br.close();

        wxDays = rows.size();
        wxTmax        = new float[wxDays];
        wxTmin        = new float[wxDays];
        wxIrrad       = new float[wxDays];
        wxRain        = new float[wxDays];
        wxWind        = new float[wxDays];
        wxTdew        = new float[wxDays];
        wxTavg        = new float[wxDays];
        wxRhAvg       = new float[wxDays];
        wxDaylightSec = new float[wxDays];
        wxSunshineSec = new float[wxDays];

        // 按列名定位（兼容新旧两种列顺序），日期归一化
        // 默认列索引（旧格式: date,irradiation,tmax,tmin,rain,wind,tdew）
        int colDate=0,colIrrad=1,colTmax=2,colTmin=3,colRain=4,colWind=5,colTdew=6;
        int colTavg=-1,colRhAvg=-1,colDaylightSec=-1,colSunshineSec=-1;
        // 读取表头自动识别列位置
        if (wxDays > 0) {
            // rows已经跳过表头，需从原始文件表头中识别——此处用固定规则判断列数
            // 新格式13列: date,irradiation,tmax,tmin,t_range,tavg,rh_avg,tdew,wind,rain,aqi,daylight_sec,sunshine_sec
            // 旧格式7列: date,irradiation,tmax,tmin,rain,wind,tdew
            String[] firstRow = (String[]) rows.get(0);
            if (firstRow.length >= 13) {
                // 新13列格式
                colIrrad=1; colTmax=2; colTmin=3; colRain=9; colWind=8; colTdew=7;
                colTavg=5; colRhAvg=6; colDaylightSec=11; colSunshineSec=12;
            }
            // 7列旧格式维持默认值
        }
        weatherCsvStartOffset = -1;
        for (int i = 0; i < wxDays; i++) {
            String[] cols = (String[]) rows.get(i);
            int nc = cols.length;
            // 归一化日期格式后再比对
            String normDate = normalizeDateStr(cols[colDate]);
            wxTmax[i]  = nc>colTmax  ? safeParseFloat(cols[colTmax], 30.0f)  : 30.0f;
            wxTmin[i]  = nc>colTmin  ? safeParseFloat(cols[colTmin], 15.0f)  : 15.0f;
            wxIrrad[i] = nc>colIrrad ? safeParseFloat(cols[colIrrad], 18.0f) : 18.0f;
            wxRain[i]  = nc>colRain  ? safeParseFloat(cols[colRain],  0.0f)  : 0.0f;
            wxWind[i]  = nc>colWind  ? safeParseFloat(cols[colWind],  2.0f)  : 2.0f;
            wxTdew[i]  = nc>colTdew  ? safeParseFloat(cols[colTdew],  wxTmin[i]-4.0f) : wxTmin[i]-4.0f;
            // 新列（若存在）
            if (colTavg>=0 && nc>colTavg)
                wxTavg[i] = safeParseFloat(cols[colTavg], (wxTmax[i]+wxTmin[i])/2.0f);
            else
                wxTavg[i] = (wxTmax[i]+wxTmin[i])/2.0f;
            if (colRhAvg>=0 && nc>colRhAvg)
                wxRhAvg[i] = safeParseFloat(cols[colRhAvg], 0.5f);
            else
                wxRhAvg[i] = 0.5f;
            if (colDaylightSec>=0 && nc>colDaylightSec)
                wxDaylightSec[i] = safeParseFloat(cols[colDaylightSec], 0.0f);
            if (colSunshineSec>=0 && nc>colSunshineSec)
                wxSunshineSec[i] = safeParseFloat(cols[colSunshineSec], 0.0f);
            if (normDate.equals("2022-05-01") && weatherCsvStartOffset < 0) {
                weatherCsvStartOffset = i;
            }
        }

        if (weatherCsvStartOffset < 0) {
            println(" [气象] 警告: 未找到出苗日, 默认从第一行开始");
            weatherCsvStartOffset = 0;
        }

        weatherCsvLoaded = true;
        println(" [气象] 加载成功: " + path + " (" + wxDays + "天)");
        println(" [气象] 出苗日偏移: 第" + weatherCsvStartOffset + "行");
        println(" [气象] 覆盖生育期: " + Math.min(GROWTH_PERIOD, wxDays - weatherCsvStartOffset) + "天");

        // 统计生育期气象概况
        float gddSum = 0; float tmaxSum = 0; float tminSum = 0; float irradSum = 0; float rainSum = 0;
        int n = Math.min(GROWTH_PERIOD, wxDays - weatherCsvStartOffset);
        for (int d = 0; d < n; d++) {
            int idx = weatherCsvStartOffset + d;
            tmaxSum += wxTmax[idx]; tminSum += wxTmin[idx]; irradSum += wxIrrad[idx]; rainSum += wxRain[idx];
            gddSum += Math.max(0, (wxTmax[idx] + wxTmin[idx]) / 2.0 - 10.0);
        }
        println(" [气象] 生育期GDD=" + String.format("%.0f", gddSum)
               + " | 均Tmax=" + String.format("%.1f", tmaxSum/n) + "°C"
               + " | 均辐射=" + String.format("%.1f", irradSum/n) + "MJ/m²/d"
               + " | 总降雨=" + String.format("%.0f", rainSum) + "mm");

    } catch (Exception e) {
        println(" [气象] 加载失败: " + e.getMessage() + " — 将使用内置气象模型");
        weatherCsvLoaded = false;
    }
}

// 获取指定生育天数的气象数据 (dayCount: 1-based)
// 返回: float[6] = {tmax, tmin, irradiation, rain, wind, tdew}
// 扩展为 float[10]
// [0]tmax [1]tmin [2]irrad [3]rain [4]wind [5]tdew
// [6]tavg [7]rh_avg [8]daylight_sec [9]sunshine_sec
static float[] getWeatherForDay(int groimp_day) {
    float[] wx = new float[10];
    if (!weatherCsvLoaded || groimp_day < 1) return wx;
    int idx = weatherCsvStartOffset + groimp_day - 1;
    if (idx < 0 || idx >= wxDays) return wx;
    wx[0] = wxTmax[idx];
    wx[1] = wxTmin[idx];
    wx[2] = wxIrrad[idx];
    wx[3] = wxRain[idx];
    wx[4] = wxWind[idx];
    wx[5] = wxTdew[idx];
    wx[6] = wxTavg[idx];
    wx[7] = (wxRhAvg != null) ? wxRhAvg[idx] : 0.5f;
    wx[8] = (wxDaylightSec != null) ? wxDaylightSec[idx] : 0.0f;
    wx[9] = (wxSunshineSec != null) ? wxSunshineSec[idx] : 0.0f;
    return wx;
}

// 简易蒸散量估算 (Hargreaves简化公式)
// ET0 = 0.0023 × Ra × (Tavg + 17.8) × (Tmax - Tmin)^0.5
// 棉花Kc: 苗期0.35, 蕾期0.75, 花铃期1.15, 吐絮期0.70
static float calcDailyET(float tavg, float tmax, float tmin, float solarRad, int day) {
    float delta = Math.max(0.1f, tmax - tmin);
    float et0 = 0.0023f * solarRad * (tavg + 17.8f) * (float)Math.sqrt(delta);
    et0 = Math.max(0, Math.min(12.0f, et0));   // 限幅 0-12 mm/d
    // Allen(1998)建议: 干旱区Hargreaves需乘以区域系数0.55-0.65
    et0 *= 0.58f;   // 阿拉尔干旱区校正系数
    // 作物系数 Kc
    float kc;
    if (day <= 20)       kc = 0.35f;
    else if (day <= 50)  kc = 0.35f + (day - 20) / 30.0f * 0.40f;
    else if (day <= 80)  kc = 0.75f + (day - 50) / 30.0f * 0.40f;
    else if (day <= 110) kc = 1.15f;
    else                 kc = 1.15f - (day - 110) / 26.0f * 0.45f;
    return et0 * kc;
}

// 土壤水分更新 (含自动滴灌)
static float updateSoilWater(float rain, float et, int day) {
    soilWaterContent += rain;
    soilWaterContent -= et;
    cumulativeET += et;
    cumulativeRain += rain;

    // 滴灌: 当SWC低于阈值且距上次灌溉超过间隔
    if (soilWaterContent < IRRIGATION_THRESHOLD && (day - lastIrrigationDay) >= IRRIGATION_INTERVAL) {
        soilWaterContent += IRRIGATION_AMOUNT;
        cumulativeIrrigation += IRRIGATION_AMOUNT;
        lastIrrigationDay = day;
    }

    // 限幅
    if (soilWaterContent > SOIL_WATER_CAPACITY) soilWaterContent = SOIL_WATER_CAPACITY;
    if (soilWaterContent < 0) soilWaterContent = 0;

    // 水分胁迫: SWC < 40mm 时开始胁迫
    float stress = 0;
    if (soilWaterContent < 40.0f) {
        stress = (40.0f - soilWaterContent) / 40.0f;
    }
    return Math.max(0, Math.min(0.8f, stress));   // 限幅 0-0.8
}

public void loadC2KInputCSV() { loadC2KInputCSV(csvInputPath); }

public void loadC2KInputCSV(String path) {
    csvInputRows.clear();
    csvLoaded = false;
    try {
        java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(path));
        String headerLine = br.readLine();
        if (headerLine == null) { println(" [CSV] 文件为空: " + path); return; }
        headerLine = headerLine.trim();
        if (headerLine.startsWith("\uFEFF")) headerLine = headerLine.substring(1);
        String[] headers = headerLine.split(",");
        String line;
        while ((line = br.readLine()) != null) {
            line = line.trim();
            if (line.isEmpty()) continue;
            String[] values = line.split(",");
            java.util.HashMap row = new java.util.HashMap();
            for (int i = 0; i < Math.min(headers.length, values.length); i++) {
                row.put(headers[i].trim(), values[i].trim());
            }
            csvInputRows.add(row);
        }
        br.close();
        csvLoaded = true;
        COUPLING_MODE = 1;
        println(" [CSV] 加载成功: " + path + " (" + csvInputRows.size() + "行)");
    } catch (Exception e) {
        println(" [CSV] 加载失败: " + e.getMessage());
        COUPLING_MODE = 0;
        csvLoaded = false;
    }
}

static float parseCSVFloat(java.util.HashMap row, String key, float defaultVal) {
    Object val = row.get(key);
    if (val == null) return defaultVal;
    try { return Float.parseFloat(val.toString().trim()); }
    catch (Exception e) { return defaultVal; }
}

static void c2kReadFromCSV(int groimp_day) {
    if (!csvLoaded || groimp_day < 1 || groimp_day > csvInputRows.size()) return;
    java.util.HashMap row = (java.util.HashMap) csvInputRows.get(groimp_day - 1);

    // PLAN-B: 移除错误的 × plantsPerM2 乘法
    // ========================================================================
    // 根因: Cotton2K (Marani 2004) 是面积基准模型, 所有干重输出单位为 g/m²地面
    // 原代码错误地将 g/m² × plantsPerM2(=20.25) 当作 "g/plant → g/m²" 转换
    // 实际上 leaf_weight 已经是 g/m², 再乘 plantsPerM2 导致虚高 20.25×
    // 验证 (Day 70 实测):
    // leaf_weight_raw ≈ 167 g/m² (= 3390/20.25, 修复前的c2k_Wleaf ÷ plantsPerM2)
    // 文献棉花峰期叶干重: 150-220 g/m² (Milroy & Bange 2003) ← 完全一致 ✓
    // 总DM_true = 18238/20.25 ≈ 901 g/m² ← 文献700-1000 g/m² ✓
    // ========================================================================
    c2k_Wleaf  = parseCSVFloat(row, "leaf_weight", 0);   // g/m² (直接使用, 不再乘plantsPerM2)
    c2k_Wstem  = parseCSVFloat(row, "stem_weight", 0);   // g/m²
    c2k_Wroot  = parseCSVFloat(row, "root_weight", 0);   // g/m²
    c2k_Wfruit = parseCSVFloat(row, "boll_weight", 0);   // g/m²
    c2k_Wtotal = parseCSVFloat(row, "plant_weight", 0);   // g/m²

    c2k_height = parseCSVFloat(row, "plant_height", 0);
    c2k_DVS    = c2kCalcDVS(parseCSVFloat(row, "GDD_cumsum", 0));

    float csv_gdd_e = parseCSVFloat(row, "GDD_after_emerge", 0);
    c2k_senesRate = C2K_SENES_RATE_BASE;
    if (csv_gdd_e > C2K_SENES_GDD_START) {
        c2k_senesRate *= (1.0 + (csv_gdd_e - C2K_SENES_GDD_START) / 500.0 * 1.5);
    }

    // PLAN-B: 源库比计算修正 (Wleaf/Wstem已修正为g/m², 需同步去除plantsPerM2)
    float plantsPerM2 = plantDensity / MU_TO_M2;
    int csv_squares = (int) parseCSVFloat(row, "number_of_squares", 0);
    int csv_bolls   = (int) parseCSVFloat(row, "number_of_green_bolls", 0);
    // 库强需求: 蕾+铃单位 g/plant → × plantsPerM2 → g/m² (这里plantsPerM2使用仍正确)
    float sinkDemand = (csv_squares * 0.08 + csv_bolls * C2K_BOLL_GROWTH_RATE) * plantsPerM2;
    float supply = c2k_Wtotal * 0.02;   // c2k_Wtotal已是g/m², 此处系数不变
    c2k_sourceSink = Math.max(0.3, Math.min(1.5, supply / Math.max(0.5, sinkDemand + supply * 0.1)));
    c2k_shedFactor = calcShedFactor(c2k_sourceSink);

    if (groimp_day >= 2) {
        java.util.HashMap prev = (java.util.HashMap) csvInputRows.get(groimp_day - 2);
        // PLAN-B: 叶生长速率 = 当日Wleaf - 前日Wleaf (均为g/m², 无需plantsPerM2)
        c2k_leafGrowthRate = Math.max(0, c2k_Wleaf - parseCSVFloat(prev, "leaf_weight", 0));
    } else c2k_leafGrowthRate = 0;

    // PLAN-B: SLA从 leaf_area_index / leaf_weight 动态推算 (单位正确: m²/m² ÷ g/m² = m²/g)
    // ========================================================================
    // 原因: Python端c2k_sla_m2g=0.001是单位混淆结果:
    // SLA_wrong = (LAI/plantsPerM2) / leaf_weight_g_m2
    // = (m²/plant) / (g/m²) = m²·m²/(plant·g) — 量纲错误
    // 正确计算: SLA = leaf_area_index(m²/m²) / leaf_weight(g/m²) = m²/g
    // ========================================================================
    float csvLAIraw = parseCSVFloat(row, "leaf_area_index", 0);   // Cotton2K的LAI(m²/m²)
    if (c2k_Wleaf > 5.0f && csvLAIraw > 0.05f) {
        float computedSLA = csvLAIraw / c2k_Wleaf;   // 正确SLA: m²/g
        // SLA 取自Cotton2K动态曲线 (c2kReadFromCSV读取c2k_sla_m2g)
        // 实测塔河2号 8/21 反推 SLA=99 cm²/g (锚点); 早期可达 175 cm²/g
        // 实测峰值LAI=2.34 (8/28观测均值, 2025), 旧版"目标2.46"已对齐
        if (computedSLA > 0.006f && computedSLA < 0.020f) {
            c2k_sla_dynamic = computedSLA;   // 预期约0.0080-0.0175 m²/g (动态曲线)
        }
    }
    // PLAN-B: c2k_LAI直接使用Cotton2K原始LAI(最精确来源)
    if (csvLAIraw > 0.01f) {
        c2k_LAI = csvLAIraw;
    } else if (c2k_Wleaf > 0) {
        c2k_LAI = c2k_Wleaf * c2k_sla_dynamic;
    }

    // 目标叶面积 = Cotton2K LAI ÷ plantsPerM2 → cm²/plant
    // (c2k_leaf_area_m2字段若存在则优先; 否则从LAI推算)
    float csvLeafAreaM2 = parseCSVFloat(row, "c2k_leaf_area_m2", 0);
    if (csvLeafAreaM2 > 0.00001f) {
        c2k_targetLeafAreaCm2 = csvLeafAreaM2 * 10000.0f;   // m²/plant → cm²/plant
    } else if (csvLAIraw > 0.01f && plantsPerM2 > 0) {
        // 从LAI推算: (m²/m²) / (plants/m²) = m²/plant → ×10000 = cm²/plant
        c2k_targetLeafAreaCm2 = csvLAIraw / plantsPerM2 * 10000.0f;
    }

    // 从相邻两天Wleaf推算真实日衰老速率
    // Cotton2K Day105后突然加速衰老(日降~6.5%)，驱动GroIMP叶片加速衰老
    if (c2k_prevWleaf > 1.0f && c2k_Wleaf < c2k_prevWleaf) {
        float rawRate = (c2k_prevWleaf - c2k_Wleaf) / c2k_prevWleaf;
        // 限幅上限0.025→0.015, 与calcLeafFuncState植株级衰老上限同步
        // 放缓GroIMP叶片功能衰退, 减少后期LAI骤降
        c2k_senesRate_real = Math.max(0.005f, Math.min(0.015f, rawRate));
    } else {
        c2k_senesRate_real = Math.max(0.005f, c2k_senesRate);
    }
    c2k_prevWleaf = c2k_Wleaf;

    // 读取 Cotton2K 内部产量字段
    float csv_lint_yield = parseCSVFloat(row, "lint_yield", 0);
    if (csv_lint_yield > 0 && csv_lint_yield > c2k_lint_yield_kgha)
        c2k_lint_yield_kgha = csv_lint_yield;
    float csv_seed_cotton = parseCSVFloat(row, "seed_cotton_yield", 0);
    if (csv_seed_cotton > 0 && csv_seed_cotton > c2k_seed_cotton_kgha)
        c2k_seed_cotton_kgha = csv_seed_cotton;

    // PATCH-3 (Plan-A): 移除后期二次融合, 保留 c2kNudgeLAI 作为唯一一致性通路
    // ========================================================================
    // 移除原因 (替代原/ 融合机制):
    // 原机制使 c2k_Wleaf 在 Day 142 时 95% 来自 GroIMP LAI 反推,
    // 导致 Cotton2K 后期独立性丧失, 两模型 LAI 偏差 -0.4% 为假一致.
    // 审稿可见: "若 C2K 的 Wleaf 是从 GroIMP LAI 反算, 则 C2K 的光合、
    // 碳分配、产量通路全部在 'GroIMP 给的叶干重' 上运行,
    // 独立性消失, '双向耦合' 名不副实".
    // 保留机制:
    // c2kNudgeLAI (调用位置在 run() 中, 此函数不变) 做每日小步调整,
    // 单日限幅 25%, 物理意义是 "C2K 自身碳平衡基础上的数据同化",
    // 是正常的耦合做法 (类似 EnKF 中的观测同化).
    // 保留诊断:
    // 两模型后期的自然分歧可在论文 Discussion 中引用为正面发现,
    // 反映 Cotton2K 碳驱动模型对衰老建模的固有不足
    // (参考 Jallas et al. 2000, Cotton2K 模型验证报告).
    // ========================================================================
    if (groimp_day > 80 && LAI > 0.05f && c2k_sla_dynamic > 0.0001f) {
        float groimpImpliedWleaf = LAI / c2k_sla_dynamic;
        float divergencePct = (c2k_Wleaf > 0.1f)
            ? (groimpImpliedWleaf - c2k_Wleaf) / c2k_Wleaf * 100.0f : 0.0f;
        if (groimp_day % 20 == 0) {
            println(" [Patch-3 诊断 CSV] Day" + groimp_day
                   + " C2K_Wleaf=" + String.format("%.1f", c2k_Wleaf)
                   + " g/m², GroIMP隐含Wleaf=" + String.format("%.1f", groimpImpliedWleaf)
                   + " g/m², 自然分歧=" + String.format("%+.1f", divergencePct) + "%");
        }
    }
}

static void initFeedbackArrays() {
    fbDay.clear(); fbDate.clear();
    fbGroimpLAI.clear(); fbGroimpLI.clear(); fbGroimpPAR.clear();
    fbPlantHeight.clear(); fbNLeaves.clear(); fbNActiveLeaves.clear();
    fbSunPhoto.clear(); fbShadePhoto.clear(); fbTotalPhoto.clear();
    fbWaterStress.clear(); fbSoilWater.clear();
    for (int i = 0; i < CANOPY_LAYERS; i++) {
        fbLayerLight[i] = new java.util.ArrayList();
        fbLayerLAI_arr[i] = new java.util.ArrayList();
    }
}

static void recordFeedback(int day) {
    fbDay.add(day);
    int doy = calcDayOfYear(day);
    java.util.Calendar cal = java.util.Calendar.getInstance();
    cal.set(java.util.Calendar.YEAR, 2022);
    cal.set(java.util.Calendar.DAY_OF_YEAR, doy);
    fbDate.add(String.format("%04d-%02d-%02d", cal.get(java.util.Calendar.YEAR),
        cal.get(java.util.Calendar.MONTH)+1, cal.get(java.util.Calendar.DAY_OF_MONTH)));
    fbGroimpLAI.add(LAI);
    fbGroimpLI.add(lightInterceptionRate);
    fbGroimpPAR.add(dailyInterceptedPAR);
    fbPlantHeight.add(plantHeight * 100);
    fbNLeaves.add(nLeaves);
    fbNActiveLeaves.add(nActiveLeaves);
    fbSunPhoto.add(c2k_sunPhoto);
    fbShadePhoto.add(c2k_shadePhoto);
    fbTotalPhoto.add(c2k_sunPhoto + c2k_shadePhoto);
    for (int i = 0; i < CANOPY_LAYERS; i++) {
        fbLayerLight[i].add(layerLightFraction[i]);
        fbLayerLAI_arr[i].add(layerLAI[i]);
    }
    // 逐日记录水分状态 (替代终态全局变量)
    fbWaterStress.add(waterStress);
    fbSoilWater.add(soilWaterContent);
}

public void setCouplingMode(int mode) {
    COUPLING_MODE = Math.max(0, Math.min(1, mode));
    println(" 耦合模式: " + (COUPLING_MODE==1 ? "CSV读取" : "内置求解器"));
}

// Sun/Shade 分层光合参数
// ====================================================================
// 非矩形双曲线 (Non-Rectangular Hyperbola, NRH):
// Pg = (Φ·I + Pmax - √((Φ·I + Pmax)² - 4·Θ·Φ·I·Pmax)) / (2·Θ)
// 其中 Φ=量子效率, Pmax=最大光合速率, Θ=曲率参数
// 阳叶/阴叶参数不同: 阳叶光饱和快, 阴叶线性段长
// ====================================================================
const float C2K_PHI_SUN = 0.050;   // 阳叶量子效率 (mol CO2/mol PAR)
const float C2K_PHI_SHADE = 0.065;   // 阴叶量子效率 (↑ 散射光适应)
// Bange & Milroy 2004 高产棉田峰值 Pmax_sun ≈ 25-30 μmol CO2/m²leaf/s
const float C2K_PMAX_SUN = 18.5;   // (+5.7%) 峰LAI 3.097→3.40, 脱落率改善
const float C2K_PMAX_SHADE = 11.5;   // (同比)
const float C2K_THETA = 0.7;   // NRH曲率参数 (0=矩形, 1=最小)
const float C2K_PAR_MJ_TO_UMOL = 4.57;   // MJ PAR → μmol/s 转换 (÷日长×1e6/3600)
// 分层模式开关: 0=原单层RUE (兼容), 1=Sun/Shade NRH
static int PHOTO_MODE = 1;
// 分层光合诊断
static float[] layerPhoto = new float[CANOPY_LAYERS];   // 各层光合 (g/m2/d)
static float c2k_sunPhoto = 0;   // 阳叶总光合
static float c2k_shadePhoto = 0;   // 阴叶总光合

// FluxLM 叶片光学属性 (PAR波段)
// ====================================================================
const float LEAF_PAR_REFLECTANCE = 0.10;   // PAR 反射率 (实测 0.08-0.12)
const float LEAF_PAR_TRANSMITTANCE = 0.05;   // PAR 透射率 (实测 0.03-0.07)
const float LEAF_PAR_ABSORPTANCE = 0.85;   // PAR 吸收率 = 1 - R - T
const float SOIL_PAR_REFLECTANCE = 0.15;   // 裸土PAR反射率

// --- C2K 初始化 ---
static void c2kSolverInit() {
    // 出苗时初始干物质 (子叶 + 种子储备)
    c2k_Wleaf = 2.5;   // g/m2, 约对应LAI≈0.05
    c2k_Wstem = 0.8;
    c2k_Wroot = 1.5;
    c2k_Wfruit = 0;
    c2k_Wtotal = c2k_Wleaf + c2k_Wstem + c2k_Wroot;
    c2k_LAI = c2k_Wleaf * c2k_sla_dynamic;   // 用动态SLA
    c2k_grossPhoto = 0;
    c2k_netPhoto = 0;
    c2k_maintResp = 0;
    c2k_growthResp = 0;
    c2k_dmSupply = 0;
    c2k_sourceSink = 1.0;
    c2k_shedFactor = 1.0;
    c2k_DVS = 0;
    c2k_leafGrowthRate = 0;
    c2k_bollGrowthRate = 0;
    c2k_senesRate = 0;
    c2k_height = 0;
    groimpLightInterception = 0;
    groimpInterceptedPAR = 0;
    c2k_senesRate_real = 0; c2k_prevWleaf = 0;
    for (int i = 0; i < CANOPY_LAYERS; i++) groimpLayerLight[i] = 0;
}

// --- C2K 温度响应函数 ---
// 梯形函数: Tmin以下为0, Tmin-Topt线性上升, Topt-Tmax线性下降, Tmax以上为0
static float c2kTempResponse(float tavg) {
    if (tavg <= C2K_TMIN_PHOTO || tavg >= C2K_TMAX_PHOTO) return 0;
    if (tavg <= C2K_TOPT_PHOTO)
        return (tavg - C2K_TMIN_PHOTO) / (C2K_TOPT_PHOTO - C2K_TMIN_PHOTO);
    return (C2K_TMAX_PHOTO - tavg) / (C2K_TMAX_PHOTO - C2K_TOPT_PHOTO);
}

// --- C2K 发育阶段计算 ---
// DVS: 0→1 (出苗→开花), 1→2 (开花→吐絮)
static float c2kCalcDVS(float gdd) {
    if (gdd < GDD_EMERGENCE) return 0;
    if (gdd < GDD_FLOWERING) return (gdd - GDD_EMERGENCE) / (GDD_FLOWERING - GDD_EMERGENCE);
    if (gdd < GDD_BOLL_OPEN) return 1.0 + (gdd - GDD_FLOWERING) / (GDD_BOLL_OPEN - GDD_FLOWERING);
    return 2.0;
}

// --- C2K 干物质分配系数 ---
// 返回 float[4]: {叶, 茎, 根, 果}
static float[] c2kPartitionCoefs(float dvs, float sourceSink) {
    float[] coef = new float[4];
    if (dvs < 0.5) {
        // 营养生长前期: 大量投叶
        coef[0] = 0.45; coef[1] = 0.30; coef[2] = 0.25; coef[3] = 0.0;
    } else if (dvs < 1.0) {
        // 营养生长后期→现蕾: 叶下降, 茎增加
        float t = (dvs - 0.5) / 0.5;
        coef[0] = 0.45 - t * 0.20;
        coef[1] = 0.30 + t * 0.05;
        coef[2] = 0.25 - t * 0.10;
        coef[3] = t * 0.25;
    } else if (dvs < 1.5) {
        // 开花→盛铃: 果大幅增加
        float t = (dvs - 1.0) / 0.5;
        coef[0] = 0.25 - t * 0.18;
        coef[1] = 0.35 - t * 0.20;
        coef[2] = 0.15 - t * 0.07;
        coef[3] = 0.25 + t * 0.45;
    } else {
        // 盛铃→吐絮: 几乎全部投果
        float t = Math.min(1.0, (dvs - 1.5) / 0.5);
        coef[0] = 0.07 - t * 0.05;
        coef[1] = 0.15 - t * 0.10;
        coef[2] = 0.08 - t * 0.05;
        coef[3] = 0.70 + t * 0.20;
    }
    // 源库比低时减少营养器官分配,增加果实竞争
    if (sourceSink < 0.8 && coef[3] > 0) {
        float shift = (0.8 - sourceSink) * 0.15;
        coef[0] = Math.max(0.01, coef[0] - shift * 0.4);
        coef[1] = Math.max(0.01, coef[1] - shift * 0.3);
        coef[2] = Math.max(0.01, coef[2] - shift * 0.3);
        // 归一化
        float sum = coef[0] + coef[1] + coef[2] + coef[3];
        for (int i = 0; i < 4; i++) coef[i] /= sum;
    }
    return coef;
}

// --- C2K 株高预测 ---
// Richards方程拟合, 与原目标一致
static float c2kCalcHeight(float gdd) {
    if (gdd < GDD_EMERGENCE) return 0;
    float t = gdd - GDD_EMERGENCE;
    float hMax = PLANT_HEIGHT_TARGET * 100;   // cm
    float k = 0.0058f;   // (原0.0042)
    float t50 = 350.0f;   // (原400.0)
    return hMax / (1.0 + (float)Math.exp(-k * (t - t50)));
}

// GroIMP 苗期/蕾期叶面积物候展叶约束因子
// ────────────────────────────────────────────────────────────────────
// 根因诊断 联调): c2k_leaf_area_m2 修复只是第一层, GroIMP L-system 在苗期
// 仍按 LEAF_MAX_AREA 全值生长叶片, 导致 naturalArea >> f_vis 修正后目标值.
// 即使 leafAreaScale 下压至 floor=0.75, 苗期 GroIMP LAI 仍达 0.50+ (实测 0.135).
// 物理依据 (与 Python f_vis 函数镜像):
// Phase A DAS 0-33: 细胞分裂期 — 叶片尺寸受细胞数量限制, 远低于最终大小
// Phase B DAS 33-64: 细胞扩增期 — 叶面积缓慢增加
// Phase C DAS 64-75: 膨压驱动全展开 — 急速达到 LEAF_MAX_AREA
// 实现: 在 getMaxLeafArea() 中用 dayCount 调节每片叶的最大目标面积上限
// 文献: Constable & Rawson 1980; Wells & Meredith 1984; Reddy et al. 1997
// 锚点 (dayCount → f_expand):
// (出苗瞬间, 子叶展开极限)
// (子叶展开)
// (第一真叶)
// (4-5片真叶)
// (★ 现蕾期开始, 此处 Python f_vis=0.144)
// (★ 初花前)
// (★ 开花期)
// (★ 开花盛期)
// (★ 盛花日, 全展开)
// ────────────────────────────────────────────────────────────────────
static float calcLeafExpandFactor(int dc) {
    // 分段线性插值 (与 Python f_vis 锚点对称设计)
    if (dc <= 0)   return 0.10f;
    if (dc >= 75)  return 1.00f;
    int[]   xs = {  0,   5,  14,  25,  33,  48,  58,  64,  75 };
    // ── 第四轮重标定 (论文优化, 与2025同基准): 苗期/蕾期上报叶面积上调, 对齐实测 LAI ──
    //   旧锚点 { 0.10, 0.14, 0.18, 0.23, 0.30, 0.50, 0.65, 0.80, 1.00 } 标定于过时认知,
    //   致 GroIMP 上报 LAI 在 DAS5-58 系统性低估 50-90% (2022 GRO err: DAS9=-85%, DAS28=-62%,
    //   DAS35=-39%), 并迫使 LAI 一致性 Nudge 累积修正达 -331g/m².
    //   依据2022实测 (DAS9=0.184, DAS28=0.735, DAS35=0.966, DAS53≈1.96 → 峰4.063),
    //   按"越欠估、修正越大"梯度抬升 DAS5-58; DAS64=0.80 / DAS75=1.00 保持不变,
    //   以锁定已精确的峰值区 (DAS66-80 GRO err 仅 -6%~-16%). 单调递增已校验.
    //   ★ 需 GroIMP 重跑验证: 比对各锚点 GRO vs 实测, 按比例迭代微调 (详见第四轮优化报告调参协议).
    float[] ys = { 0.10f, 0.20f, 0.32f, 0.45f, 0.55f, 0.68f, 0.76f, 0.80f, 1.00f };
    for (int i = 0; i < xs.length - 1; i++) {
        if (dc >= xs[i] && dc < xs[i+1]) {
            float t = (float)(dc - xs[i]) / (xs[i+1] - xs[i]);
            return ys[i] + t * (ys[i+1] - ys[i]);
        }
    }
    return 1.00f;
}
// 文献支撑: Jallas 2007 (Cotton2K源代码) — Heitholt 1993 棉花蕾铃保留率
static float calcShedFactor(float ss) {
    if (ss < 0.50f) {
        // 严重源胁迫: 略缓的最大惩罚 1.45@0 → 1.30@0.5
        return 1.45f - 0.30f * Math.max(0.0f, ss);
    } else if (ss < 0.95f) {
        // 温和惩罚区 [0.5, 0.95], 斜率 -0.30
        // 1.30@SS=0.5 → 1.165@SS=0.95 (覆盖蕾期低 SS 工况)
        return 1.30f - 0.30f * (ss - 0.50f);
    } else if (ss < 1.15f) {
        // 关键过渡区 [0.95, 1.15], 包含蕾期典型 SS≈1.05
        // 1.165@SS=0.95 → 0.885@SS=1.15 (斜率 -1.40)
        // SS=1.05 时 shedFactor=1.025, SS=1.062 时 shedFactor=1.008
        return 1.165f - 1.40f * (ss - 0.95f);
    } else {
        // 源极充足下限 (维持 的 0.88)
        return 0.88f;
    }
}

// --- C2K 每日求解器 (核心方法) ---
// ====================================================================
// 输入: lightInterception (来自GroIMP三维光追 或 Beer-Lambert后备)
// dailyPARin (日PAR, MJ/m2/d)
// tavg (日均温, °C)
// tmax (日最高温)
// gdd (累积积温)
// waterStressLevel (水胁迫 0-1)
// nBollsGroimp (GroIMP当前绿铃数)
// nSquaresGroimp (GroIMP当前蕾数)
// nFlowersGroimp (GroIMP当前花数)
// 输出: 更新所有 c2k_* 状态变量, 包括供GroIMP使用的增长增量
// ====================================================================
static void c2kDailySolve(float lightInterception, float dailyPARin,
                          float tavg, float tmaxIn, float gdd,
                          float waterStressLevel,
                          int nBollsGroimp, int nSquaresGroimp, int nFlowersGroimp) {

    // 1. 发育阶段
    c2k_DVS = c2kCalcDVS(gdd);
    c2k_height = c2kCalcHeight(gdd);

    // 2. 光合作用
    // 分层Sun/Shade模型 或 原单层RUE模型
    float interceptedPAR = dailyPARin * lightInterception;
    float tempResp = c2kTempResponse(tavg);
    float waterResp = 1.0 - 0.6 * waterStressLevel;
    float nitrogenResp = 0.7 + 0.3 * nitrogenLevel;

    if (PHOTO_MODE == 1 && c2k_LAI > 0.1) {
        // ===== Sun/Shade 分层光合 =====
        c2k_grossPhoto = c2kLayeredPhotosynthesis(dailyPARin, tavg, waterStressLevel);
    } else {
        // ===== 原单层 RUE 模型 (后备) =====
        float effectiveRUE = C2K_RUE;
        if (interceptedPAR > 0 && c2k_LAI > 0) {
            float parPerLAI = interceptedPAR / c2k_LAI;
            if (parPerLAI < 2.0) effectiveRUE = C2K_RUE_MAX;
            else if (parPerLAI < 5.0) effectiveRUE = C2K_RUE_MAX - (C2K_RUE_MAX - C2K_RUE) * (parPerLAI - 2.0) / 3.0;
        }
        c2k_grossPhoto = interceptedPAR * effectiveRUE * tempResp * waterResp * nitrogenResp;
    }
    // 单位: MJ/m2/d × g/MJ = g/m2/d

    // 高温光合抑制移至 grossPhoto 计算后立即应用 (修复原 时序错误)
    // 原 位置在 dmSupply 计算之后 (step 12), 导致 maintResp/growthResp 均基于未抑制值:
    // 错误路径: gross(未抑制)→maint→net→growth→dmSupply → 最后才 ×0.85 (无效)
    // 正确路径: gross → ×高温因子 → 抑制后 gross → maint → net → growth → dmSupply
    // 物理依据: 高温直接抑制 Rubisco 活性和光合电子传递链 (Crafts-Brandner & Salvucci 2000),
    // 影响源头是 gross photosynthesis, 而非干物质供应的末端
    // 参数: 38°C 以上线性抑制, 43°C 时最大抑制 15% (与 旧值 0.85 相同,但时序正确)
    if (tmaxIn > 38.0f) {
        float heatStress = Math.min(1.0f, (tmaxIn - 38.0f) / 5.0f);   // (38°C→43°C)
        c2k_grossPhoto *= (1.0f - 0.15f * heatStress);   // 最大抑制 15%, 连续线性 (原 阈值式 ×0.85)
    }

    // 3. 维持呼吸
    float q10factor = (float)Math.pow(C2K_Q10, (tavg - 25.0) / 10.0);
    c2k_maintResp = (c2k_Wleaf * C2K_MAINT_RESP_LEAF
                   + c2k_Wstem * C2K_MAINT_RESP_STEM
                   + c2k_Wroot * C2K_MAINT_RESP_ROOT
                   + c2k_Wfruit * C2K_MAINT_RESP_FRUIT) * q10factor;

    // 净光合 = 总光合 - 维持呼吸
    c2k_netPhoto = Math.max(0, c2k_grossPhoto - c2k_maintResp);

    // 4. 生长呼吸
    c2k_growthResp = c2k_netPhoto * C2K_GROWTH_RESP_COEF;

    // 可用干物质
    c2k_dmSupply = c2k_netPhoto - c2k_growthResp;
    c2k_dmSupply = Math.max(0, c2k_dmSupply);

    // 5. 源库比计算
    // 源 = 干物质供应; 库 = 各器官的需求
    float sinkDemand = 0;
    if (c2k_DVS > 0.5) {
        sinkDemand = nSquaresGroimp * 0.08 + nFlowersGroimp * 0.15
                   + nBollsGroimp * C2K_BOLL_GROWTH_RATE;
        // 转为 g/m2: 每株×密度
        // 修正密度换算 (株/亩 → 株/m²)
        // 旧代码: plantDensity/10000 × MU_TO_M2/10000 = 0.09 株/m² ← 错误, 误差 ×225
        // 根因: 将 MU_TO_M2(666.667) 误当作分子而非仅做除法
        // 正确: plantDensity / MU_TO_M2 = 14700/666.667 = 22.05 株/m²: 22万/hm²)
        // 影响: 旧值使 sinkDemand↓225×, SS 恒=1.5 (碳充裕假象), 独立模式脱落全由温度驱动而非 C2K 碳平衡
        sinkDemand *= (float)(plantDensity / MU_TO_M2);
    }
    float totalSink = sinkDemand + c2k_dmSupply * 0.1;   // 营养生长最低需求
    if (totalSink < 0.5) totalSink = 0.5;
    c2k_sourceSink = Math.max(0.3, Math.min(1.5, c2k_dmSupply / totalSink));

    // 6. 脱落调节因子 (传给GroIMP)
    // 调用统一 helper, 不再内联公式 (防止两处不同步)
    c2k_shedFactor = calcShedFactor(c2k_sourceSink);
    // 已删除原高温叠加至 shedFactor 的代码 (温度由 calcShedProb 统一处理)

    // 7. 干物质分配
    float[] partCoef = c2kPartitionCoefs(c2k_DVS, c2k_sourceSink);
    float dWleaf = c2k_dmSupply * partCoef[0];
    float dWstem = c2k_dmSupply * partCoef[1];
    float dWroot = c2k_dmSupply * partCoef[2];
    float dWfruit = c2k_dmSupply * partCoef[3];

    // 8. 叶面积衰老
    c2k_senesRate = C2K_SENES_RATE_BASE;
    if (gdd > C2K_SENES_GDD_START) {
        float senesAccel = (gdd - C2K_SENES_GDD_START) / 500.0;
        c2k_senesRate *= (1.0 + senesAccel * 1.5);
    }
    // 水胁迫加速衰老
    c2k_senesRate *= (1.0 + waterStressLevel * 1.5);

    float leafSenes = c2k_Wleaf * c2k_senesRate;
    // 保证不会衰老到负值
    leafSenes = Math.min(leafSenes, c2k_Wleaf * 0.5);

    // 9. 更新状态
    c2k_Wleaf = Math.max(0.5, c2k_Wleaf + dWleaf - leafSenes);
    c2k_Wstem += dWstem;
    c2k_Wroot += dWroot;
    c2k_Wfruit += dWfruit;
    c2k_Wtotal = c2k_Wleaf + c2k_Wstem + c2k_Wroot + c2k_Wfruit;

    // 10. LAI 更新
    float newLAI = c2k_Wleaf * c2k_sla_dynamic;   // 用动态SLA
    // 移除上限5.0 — 让C2K碳平衡自然驱动LAI, 与GroIMP衰老保持一致
    c2k_LAI = Math.max(0.05, newLAI);

    // 11. 输出给GroIMP的生长速率
    c2k_leafGrowthRate = dWleaf;   // g/m2/d 叶增重
    c2k_bollGrowthRate = dWfruit;   // g/m2/d 果增重
    // 高温抑制已在 step 2 之后立即应用, 此处不再重复
}

// 【改造7】分层 Sun/Shade 光合模型
// ====================================================================
// 非矩形双曲线 (NRH): 单叶光响应
// Pg = (Φ·I + Pmax - √((Φ·I + Pmax)² - 4·Θ·Φ·I·Pmax)) / (2·Θ)
// 各层光强 → 各层光合速率 → 加权求和 = 冠层总光合
// 分层数据来自 groimpLayerLight[] 和 layerLAI[]
// ====================================================================
// 单叶 NRH 光响应 (μmol CO2/m²/s → g DM/m²/d 由调用者转换)
// 输入: par = 叶面PAR (μmol photons/m²/s), phi = 量子效率, pmax = 最大光合
// 输出: 瞬时光合速率 (μmol CO2/m²/s)
static float nrhLeafPhoto(float par, float phi, float pmax) {
    if (par <= 0 || pmax <= 0) return 0;
    float a = phi * par + pmax;
    float disc = a * a - 4.0 * C2K_THETA * phi * par * pmax;
    if (disc < 0) disc = 0;
    return (a - (float)Math.sqrt(disc)) / (2.0 * C2K_THETA);
}

// 冠层分层光合: 接收日 PAR 输入, 返回日总光合 (g DM/m²/d)
// layerLAI从m²/plant转换为无量纲LAI (m²leaf/m²ground)
// FluxLM模式下 addLeafToAggregator 累积的是叶面积 m²/plant
// NRH公式需要无量纲LAI, 否则光合低估~20倍
static float c2kLayeredPhotosynthesis(float dailyPARin, float tavg, float waterStressLevel) {
    float tempResp = c2kTempResponse(tavg);
    float waterResp = 1.0 - 0.6 * waterStressLevel;
    float nitrogenResp = 0.7 + 0.3 * nitrogenLevel;

    int doy = calcDayOfYear(dayCount);
    // 优先使用实测白昼时长（来自 CSV 或 Socket），精度高于天文公式
    float daylengthSec;
    if (currentDaylightSec > 3600.0f) {
        daylengthSec = currentDaylightSec;
    } else {
        float daylength = calcDaylength(doy);
        if (daylength <= 0) daylength = 12.0;
        daylengthSec = daylength * 3600.0f;
    }

    // 日PAR (MJ/m²/d) → 平均瞬时PAR (μmol/m²/s)
    float meanPARtop = dailyPARin * 1e6 / daylengthSec * C2K_PAR_MJ_TO_UMOL;

    // 单株占地面积 (m²/plant) 用于 layerLAI 单位转换
    float groundAreaPerPlant = MU_TO_M2 / plantDensity;   // m²/plant

    float totalCanopyPhoto = 0;
    c2k_sunPhoto = 0;
    c2k_shadePhoto = 0;
    float totalLayerLAI = 0;

    // 预扫描确定阳叶层 — 在循环外一次性判定
    // c2k_LAI来自Cotton2K CSV, Day40即>2.0, 触发经典模式(i<2=阳叶)
    // 但GroIMP 3D叶片仍在L3-L4, 导致阳叶层空置, sun_photo=0持续到Day50
    // 根治: 不依赖任何LAI阈值, 直接检查L0+L1是否有实际叶片
    // 有叶 → 经典模式(前2层=阳叶); 无叶 → 最高有叶层=阳叶
    boolean topLayersOccupied = false;
    int topOccupiedLayer = CANOPY_LAYERS - 1;
    for (int k = 0; k < CANOPY_LAYERS; k++) {
        float kLAI_raw = layerLAI[k];
        float kLAI_chk = (LIGHT_MODE >= 1 && fluxLMAvailable && groundAreaPerPlant > 0.001f)
            ? kLAI_raw / groundAreaPerPlant : kLAI_raw;
        if (kLAI_chk > 0.001) {
            topOccupiedLayer = k;
            if (k < 2) topLayersOccupied = true;
            break;
        }
    }

    for (int i = 0; i < CANOPY_LAYERS; i++) {
        // 将 m²/plant 转换为无量纲 LAI (m²leaf/m²ground)
        float lLAI_raw = layerLAI[i];   // m²leaf/plant (FluxLM模式) 或 无量纲 (Beer-Lambert模式)
        float lLAI;
        if (LIGHT_MODE >= 1 && fluxLMAvailable && groundAreaPerPlant > 0.001f) {
            lLAI = lLAI_raw / groundAreaPerPlant;   // 转为无量纲 LAI
        } else {
            lLAI = lLAI_raw;   // Beer-Lambert模式已经是无量纲
        }
        if (lLAI <= 0.001) { layerPhoto[i] = 0; continue; }
        totalLayerLAI += lLAI;

        // 该层平均叶面 PAR (μmol/m²/s)
        float layerPAR = meanPARtop * Math.max(0, layerLightFraction[i]);

        // 阳叶/阴叶判定 (使用预扫描结果)
        // topLayersOccupied=true → 经典: 前2层=阳叶(Pmax=7.0), 后3层=阴叶(4.5)
        // topLayersOccupied=false → 苗期: 最高有叶层=阳叶, 其余=阴叶
        float phi, pmax;
        boolean isSunLayer;
        if (topLayersOccupied) {
            isSunLayer = (i < 2);
        } else {
            isSunLayer = (i == topOccupiedLayer);
        }
        if (isSunLayer) {
            phi = C2K_PHI_SUN;
            pmax = C2K_PMAX_SUN * nitrogenResp;
        } else {
            phi = C2K_PHI_SHADE;
            pmax = C2K_PMAX_SHADE * nitrogenResp;
        }

        // NRH 单叶瞬时光合 (μmol CO2/m²leaf/s)
        float leafPhoto = nrhLeafPhoto(layerPAR, phi, pmax);

        // 温度和水分响应
        leafPhoto *= tempResp * waterResp;

        // 转换: μmol CO2/m²leaf/s → g CH2O/m²ground/d
        // = leafPhoto × LAI_layer × daylength_s × 30e-6 (g CH2O/μmol CO2)
        float layerGross = leafPhoto * lLAI * daylengthSec * 30e-6;

        layerPhoto[i] = layerGross;
        totalCanopyPhoto += layerGross;

        // 使用动态阈值统计阳叶/阴叶光合
        if (isSunLayer) c2k_sunPhoto += layerGross;
        else c2k_shadePhoto += layerGross;
    }

    // 如果分层LAI太小(早期), 退回RUE模型
    if (totalLayerLAI < 0.1 || totalCanopyPhoto <= 0) {
        float interceptedPAR = dailyPARin * groimpLightInterception;
        return interceptedPAR * C2K_RUE * tempResp * waterResp * nitrogenResp;
    }

    return Math.max(0, totalCanopyPhoto);
}

// 【改造5】LAI 一致性软约束 (Nudge)
// ====================================================================
// 在 c2kDailySolve() 之后调用
// 比较 GroIMP LAI (三维结构真值) 与 C2K LAI (碳平衡推演值)
// 偏差过大时按指数衰减率 nudge c2k_Wleaf → 收敛
// ====================================================================
static void c2kNudgeLAI(float groimpLAI) {
    c2k_nudgeAmount = 0;
    if (groimpLAI < 0.05 || c2k_LAI < 0.05) return;
    float dvsFactor;
    if (dayCount <= 80) {
        dvsFactor = 1.0f;
    } else if (dayCount <= 110) {
        // 衔接 110d 处过渡到 0.10
        dvsFactor = 1.0f - (float)(dayCount - 80) / 30.0f * 0.90f;
    } else {
        dvsFactor = 0.10f;   // (避免末期 GroIMP 单独衰老至崩溃)
    }

    // 相对偏差 = |GroIMP - C2K| / max(两者)
    float maxLAI = Math.max(groimpLAI, c2k_LAI);
    float relDiff = Math.abs(groimpLAI - c2k_LAI) / maxLAI;

    if (relDiff > LAI_NUDGE_THRESHOLD) {
        // 目标 Wleaf = groimpLAI / SLA 修改6: 用动态SLA
        float targetWleaf = groimpLAI / c2k_sla_dynamic;

        // 每日调整量: (目标 - 当前) × (1 - exp(-1/τ)) × dvsFactor, 限幅
        float gap = targetWleaf - c2k_Wleaf;
        float dailyRate = 1.0 - (float)Math.exp(-1.0 / LAI_NUDGE_TAU);
        float nudge = gap * dailyRate * dvsFactor;   // dvsFactor 衰减

        // 限幅: 单日不超过 gap 的 MAX_RATE
        float maxNudge = Math.abs(gap) * LAI_NUDGE_MAX_RATE * dvsFactor;
        nudge = Math.max(-maxNudge, Math.min(maxNudge, nudge));

        // 应用
        c2k_Wleaf = Math.max(0.5, c2k_Wleaf + nudge);
        c2k_Wtotal = c2k_Wleaf + c2k_Wstem + c2k_Wroot + c2k_Wfruit;
        c2k_LAI = Math.max(0.05, c2k_Wleaf * c2k_sla_dynamic);   // 修改7 +

        c2k_nudgeAmount = nudge;
        c2k_cumulativeNudge += nudge;
        c2k_nudgeCount++;
    }
}

// 【改造6】FluxLM 场景配置
// ====================================================================
// 编程式创建平行光源 (模拟太阳直射)
// 配置叶片 Shader 的 PAR 波段光学属性
// 由 setLightMode(1) 自动调用, 或用户手动调用
// ====================================================================
static boolean fluxSceneConfigured = false;

public void setupFluxLMScene() {
    try {
        println(" [FluxLM配置] 太阳光源已自动创建 (SunLight模块)");
        println(" [FluxLM配置] 太阳高度角: ~60° (阿拉尔生育期均值)");
        println(" [FluxLM配置] 光源功率: 每日动态校准 (匹配当日PAR)");
        println(" [FluxLM配置] 叶片PAR光学属性:");
        println(" 反射率 = " + LEAF_PAR_REFLECTANCE);
        println(" 透射率 = " + LEAF_PAR_TRANSMITTANCE);
        println(" 吸收率 = " + LEAF_PAR_ABSORPTANCE);
        println(" [FluxLM配置] 土壤PAR反射率 = " + SOIL_PAR_REFLECTANCE);

        fluxSceneConfigured = true;
        println(" [FluxLM配置] 场景配置完成。");

    } catch (Exception e) {
        println(" [FluxLM配置] 错误: " + e.getMessage());
        fluxSceneConfigured = false;
    }
}

// ========== 【改造2+3】光模型桥接层 ==========
// ====================================================================
// 三种模式:
// LIGHT_MODE=0: Beer-Lambert (原, 后备)
// LIGHT_MODE=1: FluxLM CPU蒙特卡洛光追踪
// 输出: groimpLightInterception, groimpInterceptedPAR, groimpLayerLight[]
// 每个Blade的absorbedPAR字段
// ====================================================================
// .5原有的太阳辐射计算 (保留, 用于所有模式)
static int calcDayOfYear(int day) { return 117 + day; }
static float calcSolarDeclination(int doy) {
    return (float)Math.toRadians(23.45 * Math.sin(2.0 * Math.PI * (284.0 + doy) / 365.0));
}
static float calcDaylength(int doy) {
    float latRad = (float)Math.toRadians(LATITUDE);
    float dec = calcSolarDeclination(doy);
    float cosHA = Math.max(-1.0, Math.min(1.0, -Math.tan(latRad) * Math.tan(dec)));
    return 24.0 * (float)Math.acos(cosHA) / (float)Math.PI;
}
static float calcExtraterrestrialRadiation(int doy) {
    float latRad = (float)Math.toRadians(LATITUDE);
    float dec = calcSolarDeclination(doy);
    float dr = 1.0 + 0.033 * (float)Math.cos(2.0 * Math.PI * doy / 365.0);
    float cosHA = Math.max(-1.0, Math.min(1.0, -Math.tan(latRad) * Math.tan(dec)));
    float ha = (float)Math.acos(cosHA);
    return (24.0 * 60.0 / (float)Math.PI) * 0.0820 * dr *
           (ha * Math.sin(latRad) * Math.sin(dec) + Math.cos(latRad) * Math.cos(dec) * Math.sin(ha));
}
static float calcDailySolarRadiation(int doy) {
    float Ra = calcExtraterrestrialRadiation(doy);
    float Rs = Ra * (0.25 + 0.50 * (0.85 + seededRnd(-0.05f, 0.05f)));
    return Rs * (1.0 + 0.07 * (ALTITUDE / 1000.0));
}
static float calcPAR(float solarRad) { return solarRad * 0.48; }

// Beer-Lambert 后备 (LIGHT_MODE=0)
static float calcLightInterceptionBeerLambert(float lai, int doy) {
    if (lai <= 0) return 0;
    float k = LIGHT_EXT_COEF;
    float latRad = (float)Math.toRadians(LATITUDE);
    float dec = calcSolarDeclination(doy);
    float solarElev = (float)Math.toDegrees(Math.asin(Math.sin(latRad)*Math.sin(dec)+Math.cos(latRad)*Math.cos(dec)));
    if (solarElev < 60) k *= (1.0 + 0.3 * (60.0 - solarElev) / 60.0);
    k *= (1.0 + 0.1 * chemicalControl);
    float direct = 1.0 - (float)Math.exp(-k * lai);
    float diffuse = 1.0 - (float)Math.exp(-LIGHT_EXT_COEF_DIFF * lai);
    return Math.min(0.95, (1.0 - DIFFUSE_FRAC) * direct + DIFFUSE_FRAC * diffuse);   // 与FluxLM模式同步收紧, 符合膜下滴灌棉物理上限
}

// FluxLightModel 三维光追踪 (LIGHT_MODE=1)
// ====================================================================
// 调用GroIMP内置FluxLightModel引擎 (de.grogra.rgg.FluxLightModel):
// 1. 创建 FluxLightModel(rayCount, maxDepth)
// 2. compute() 对场景中所有几何体执行蒙特卡洛光线追踪
// 3. getAbsorbedPower(node) 返回 Spectrum → 转为float
// 4. 结果写入每个Blade的absorbedPAR字段
// 光源: FluxLightModel自动读取场景图中的Light节点
// 如果场景中无Light节点, compute()结果全为0 → 自动降级
// ====================================================================
static boolean fluxLMAvailable = false;
static FluxLightModel flm = null;   // 持有FluxLM实例供Blade规则查询
static int lmRayCount = 500000;   // 射线数
static int lmDepth = 10;   // 最大光线反弹深度

static void runFluxLMLightModel() {
    try {
        // 创建FluxLightModel (GroIMP内置, de.grogra.rgg包, 无需额外import)
        // 构造函数: FluxLightModel(int rayCount, int maxDepth)
        lmRayCount = FLUX_RAY_COUNT;
        flm = new FluxLightModel(lmRayCount, lmDepth);

        // compute()自动:
        // - 从场景图读取所有Light节点作为光源
        // - 遍历所有带Shader的几何体 (Blade, Internode等)
        // - 蒙特卡洛射线追踪, 计算每个表面的吸收/反射/透射
        flm.compute();

        fluxLMAvailable = true;
        if (dayCount <= 1 || dayCount % 30 == 0) {
            println(" [FluxLM] 光追踪完成, 射线数=" + lmRayCount + ", 深度=" + lmDepth);
        }

    } catch (Exception e) {
        // FluxLightModel不可用: 降级到Beer-Lambert
        fluxLMAvailable = false;
        flm = null;
        if (dayCount <= 1) {
            println(" [警告] FluxLightModel不可用: " + e.getMessage());
            println(" [警告] 降级到Beer-Lambert后备模式 (LIGHT_MODE自动切为0)");
        }
    }
}

// 从FluxLM获取单个Blade的吸收辐射功率 (W)
// FluxLightModel.getAbsorbedPower(node) 返回 de.grogra.ray.physics.Spectrum
// 在标准3通道配置下, 返回值通常是 Spectrum3d 实例 (x,y,z = R,G,B通道)
// 对非Spectrum3d的Spectrum实例, 通过 Spectrum.get(Tuple3d) 提取通道值
static float getFluxLMAbsorbedPower(Node node) {
    if (flm == null || !fluxLMAvailable) return -1;
    try {
        Object result = flm.getAbsorbedPower(node);
        if (result == null) return 0;
        if (result instanceof Spectrum3d) {
            Spectrum3d s3d = (Spectrum3d) result;
            return (float)(s3d.x + s3d.y + s3d.z);
        }
        // 非Spectrum3d情况: 通过Spectrum.get(Tuple3d)提取通道值
        de.grogra.ray.physics.Spectrum spec = (de.grogra.ray.physics.Spectrum) result;
        Spectrum3d tmp = new Spectrum3d();
        spec.get(tmp);
        return (float)(tmp.x + tmp.y + tmp.z);
    } catch (Exception e) {
        return -1;
    }
}

// 逐叶光截获收集 + 聚合
// ====================================================================
// 在生长规则中, 每个Blade通过图查询获取FluxLM结果
// 本方法将逐叶数据聚合为Cotton2K输入格式
// ====================================================================
static float totalLeafAreaForLight = 0;
static float totalAbsorbedPARSum = 0;   // 所有叶片吸收PAR总和 (W)
static float canopyMaxHeight = 0;   // 冠层最大高度 (m)
static float canopyMinHeight = 999;   // 冠层最小高度
// PATCH-4 (Plan-A): FluxLM 诊断量 — 保留原始 LI 供论文展示三维光追的独立贡献
// 原代码 (finalizeLightAggregation) 将 rawLI 锚定到 Beer-Lambert × 1.03 后再扣行间漏光,
// 最终值紧贴 Beer-Lambert 使 FluxLM 的三维计算价值难以在论文中量化. 本 patch
// 保留锚定逻辑 (物理合理性保障), 但额外记录 raw/beer/capped 三个值供后续分析.
static float fluxlm_raw_LI    = 0;   // 未锚定的原始 FluxLM 光截获率
static float fluxlm_beer_LI   = 0;   // 同 LAI 下 Beer-Lambert 理论值 (参照)
static float fluxlm_capped_LI = 0;   // 锚定后、未扣行间漏光的值

static void resetLightAggregation() {
    totalLeafAreaForLight = 0;
    totalAbsorbedPARSum = 0;
    canopyMaxHeight = 0;
    canopyMinHeight = 999;
    for (int i = 0; i < CANOPY_LAYERS; i++) {
        layerLightFraction[i] = 0;
        layerLAI[i] = 0;
        layerAbsorbedPAR[i] = 0;
        groimpLayerLight[i] = 0;
    }
}

// 由Blade规则调用: 将单叶数据添加到聚合器
// 注意: absorbedPAR 在FluxLM模式下是该叶片的总吸收功率 (W), 不是功率密度
static void addLeafToAggregator(float leafArea, float absorbedPAR, float height, int layerIdx) {
    totalLeafAreaForLight += leafArea;
    totalAbsorbedPARSum += absorbedPAR;   // FluxLM: 已经是该叶片总吸收功率(W)
    if (height > canopyMaxHeight) canopyMaxHeight = height;
    if (height < canopyMinHeight) canopyMinHeight = height;
    if (layerIdx >= 0 && layerIdx < CANOPY_LAYERS) {
        layerLAI[layerIdx] += leafArea;
        layerAbsorbedPAR[layerIdx] += absorbedPAR;
    }
}

// 完成聚合: 计算冠层光截获率 → 传给Cotton2K
static void finalizeLightAggregation() {
    int doy = calcDayOfYear(dayCount);
    float solarRad;
    // 优先使用实测辐射
    if (weatherCsvLoaded) {
        float[] wx = getWeatherForDay(dayCount);
        solarRad = (wx[2] > 0) ? wx[2] : calcDailySolarRadiation(doy);
    } else {
        solarRad = calcDailySolarRadiation(doy);
    }
    dailySolarRad = solarRad;
    dailyPAR = calcPAR(solarRad);

    float groundArea = MU_TO_M2 / plantDensity * 10000;   // cm2/株
    float groundAreaM2 = groundArea / 10000.0;   // m2/株

    if (LIGHT_MODE == 0 || !fluxLMAvailable) {
        // ===== Beer-Lambert 后备模式 =====
        groimpLightInterception = calcLightInterceptionBeerLambert(LAI, doy);
        groimpInterceptedPAR = dailyPAR * groimpLightInterception;

        // 分层 (均匀切分LAI)
        if (LAI > 0) {
            float lpl = LAI / CANOPY_LAYERS;
            float cumLAI = 0;
            for (int i = 0; i < CANOPY_LAYERS; i++) {
                layerLAI[i] = lpl;
                float lt = (float)Math.exp(-LIGHT_EXT_COEF * cumLAI);
                cumLAI += lpl;
                float lb = (float)Math.exp(-LIGHT_EXT_COEF * cumLAI);
                layerLightFraction[i] = (lt + lb) / 2.0;
                groimpLayerLight[i] = layerLightFraction[i];
                layerAbsorbedPAR[i] = dailyPAR * (lt - lb);
            }
        }
    } else {
        // ===== FluxLightModel 三维光追模式 =====
        // 从聚合数据计算冠层光截获率
        float totalIncomingPAR = dailyPAR * groundAreaM2;   // MJ/株 (入射到地面的PAR)
        if (totalIncomingPAR > 0 && totalAbsorbedPARSum > 0) {
            // totalAbsorbedPARSum 是FluxLM计算的实际吸收量
            // 将W转换为MJ/d (日累积): × 日照时数 × 3600 / 1e6
            float daylength = calcDaylength(doy);
            float absorbedMJ = totalAbsorbedPARSum * daylength * 3600.0 / 1e6;
            float rawLI = absorbedMJ / (dailyPAR * groundAreaM2);
            // 动态上限替代硬编码0.98
            // 根因: FluxLM单株光追无邻株遮挡, LAI>2.0后原始LI>0.98被截断为常数0.98
            // Day68-134连续59天LI=0.98, 反馈信息量=0
            // 修复: Beer-Lambert理论值 × 1.10 作为动态上限 (FluxLM三维光追合理高于一维)
            // 物理上限0.995 (不可超过99.5%)
            // 效果: LAI=3.0时beerLI≈0.93, 动态上限≈0.97, FluxLM在0.91-0.97间自然波动
            // 进一步收紧 — 原 (0.995, beerLI×1.10) 仍允许越界
            // 新: (0.95, beerLI×1.03) + 扣除3%行间漏光, 反映真实物理
            float beerLI = calcLightInterceptionBeerLambert(LAI, doy);
            float dynamicCap = Math.min(0.95f, beerLI * 1.03f);
            float capped = Math.min(dynamicCap, rawLI);
            // 扣除行间漏光 (棉花窄行66cm缝隙 + 天顶透射)
            groimpLightInterception = capped * (1.0f - ROW_GAP_FRAC);
            groimpInterceptedPAR = dailyPAR * groimpLightInterception;

            // PATCH-4 (Plan-A): 保留 rawLI/beerLI/capped 三值供论文诊断
            // 主逻辑保持不变 (物理上限 cap 有合理性), 此处仅额外记录.
            // 用途: 在论文 Results 中展示 "Raw FluxLM vs Beer-Lambert 偏差",
            // 证明三维光追模型在当前耦合架构中的独立数据价值.
            fluxlm_raw_LI    = rawLI;
            fluxlm_beer_LI   = beerLI;
            fluxlm_capped_LI = capped;
            if (dayCount <= 5 || dayCount % 20 == 0) {
                float rawVsBeer = (beerLI > 0.001f) ? (rawLI - beerLI) / beerLI * 100.0f : 0.0f;
                println(" [Patch-4 LI诊断] Day" + dayCount
                       + " RawFluxLM=" + String.format("%.3f", rawLI)
                       + " BeerL=" + String.format("%.3f", beerLI)
                       + " Capped=" + String.format("%.3f", capped)
                       + " Final=" + String.format("%.3f", groimpLightInterception)
                       + " | RawOverBeer=" + String.format("%+.1f", rawVsBeer) + "%");
            }
        } else {
            groimpLightInterception = 0;
            groimpInterceptedPAR = 0;
        }

        // 分层光截获 (基于叶片实际三维位置)
        // 光截获率物理上限收紧 (原 0.995 → 0.95) — 消除 >99% 违反物理的现象
        for (int i = 0; i < CANOPY_LAYERS; i++) {
            if (totalLeafAreaForLight > 0) {
                groimpLayerLight[i] = layerAbsorbedPAR[i] / Math.max(0.001, totalAbsorbedPARSum);
                layerLightFraction[i] = groimpLayerLight[i];
            }
        }
    }

    // 更新全局光变量 (兼容性)
    lightInterceptionRate = groimpLightInterception;
    dailyInterceptedPAR = groimpInterceptedPAR;
    cumulativeInterceptedPAR += dailyInterceptedPAR;

    // 记录数据
    lightDataDays.add(dayCount);
    lightDataLAI.add(LAI);
    lightDataInterception.add(lightInterceptionRate * 100);
    lightDataPAR.add(dailyInterceptedPAR);
}

// 根据叶片三维高度确定所在冠层层号
// 恢复原始5层均分 —的自适应分层映射方向错误
// 2层模式layer偏移+3, 所有叶片反而映射到L3-L4(阴叶层), 比原版更差
// 正确修复: 保留物理分层不变, 改在c2kLayeredPhotosynthesis中动态调整阳叶/阴叶阈值
static int calcCanopyLayer(float leafHeight, float maxH) {
    if (maxH <= 0) return CANOPY_LAYERS - 1;
    float relH = leafHeight / maxH;
    int layer = (int)((1.0 - relH) * CANOPY_LAYERS);
    return Math.max(0, Math.min(CANOPY_LAYERS - 1, layer));
}

