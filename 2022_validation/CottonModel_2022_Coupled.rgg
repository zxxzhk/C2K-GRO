// ========== 【改造1】Cotton2K 动态求解器 ==========
// RUE 1.80→3.40 与 Pythond 同步 (Bange&Milroy 2004 高产棉 3.2-3.5)
const float C2K_RUE = 3.40;   // (Bange&Milroy 2004 高产棉)
const float C2K_RUE_MAX = 3.65;   // 同步抬升 (低光强补偿系数)
const float C2K_TOPT_PHOTO = 28.0;   // 光合最适温 (°C)
const float C2K_TMIN_PHOTO = 12.0;   // 光合最低温
const float C2K_TMAX_PHOTO = 40.0;   // 光合最高温

// 呼吸参数
// 维持呼吸系数全面下调 (Reddy 1996 棉花活组织文献下限)
// 旧值偏向草本平均 (0.015 LEAF / 0.010 STEM等), 木质化部分被错误计入活组织
// Pythond MAINT_RESP_COEFF=0.005 已验证标定; RGG 改至各组织 0.005-0.010 范围
// 关键论据: 棉花成熟期茎/根的木质化部分≥40-60% 不参与维持呼吸 (Lambers&Atkin 2008)
const float C2K_MAINT_RESP_LEAF = 0.010;   // (叶为活组织, 但低于草本均值)
const float C2K_MAINT_RESP_STEM = 0.005;   // (茎60%木质化, 仅活组织呼吸)
const float C2K_MAINT_RESP_ROOT = 0.006;   // (根40%木质化)
const float C2K_MAINT_RESP_FRUIT = 0.008;   // (铃高代谢, 但低于旧值)
const float C2K_Q10 = 2.0;   // 温度系数
const float C2K_GROWTH_RESP_COEF = 0.22;   // (Penning de Vries 1974 铃丰富组织下限)

// 干物质分配参数 (随发育阶段变化)
// DVS: 0=出苗, 1=开花, 2=吐絮
const float C2K_SLA = 0.0150;   // 占位 (优先取CSV的c2k_sla_m2g动态值)
                                      // 峰期 SLA≈150 cm²/g 与 2022实测 LAI=4.06 + W_lf≈271 g/m² 自洽
// 净光合单位换算 (g CH₂O → g DM, Penning de Vries 1974)
const float NET_PHOTO_GCH2O_TO_GDM = 0.83f;
const float C2K_SENES_RATE_BASE = 0.008;   // 基础衰老速率 (1/d)
const float C2K_SENES_GDD_START = 1500.0;   // 衰老加速的GDD阈值

// 铃生长参数
const float C2K_BOLL_GROWTH_RATE = 0.37;   // (随 BOLL_WEIGHT_MAX 7.90→7.20 同步比例下调)
                                             // 依据: 0.40 × 7.20/7.90 = 0.365 → 取 0.37 g/d (保持与最大铃重的物理一致性)
                                             // 影响 sinkDemand 计算: 铃库需求略降 → SS 略升 → 铃重 SS 惩罚减弱 (与 7.20 配合达到目标 6.30g)
const float C2K_BOLL_MATURE_GDD = 800.0;   // 铃成熟所需GDD

// --- C2K 求解器状态变量 ---
static float c2k_Wleaf = 0;   // 叶干重 (g/m2地面)
static float c2k_Wstem = 0;   // 茎干重
