const float LEAF_MAX_AREA_MID = 68.0;    // 果枝叶最大面积 (cm², 按比例上调)
const float LEAF_MAX_AREA_OUT = 31.0;    // 外位叶最大面积 (cm²)
const float PETIOLE_LENGTH = 0.052;
// 古丽娜孜等 2025 阿拉尔 D2 实测叶片有效活性期 ~ 100-115 天
// Reddy & Hodges 1990 棉花叶寿命 90-130 天 (温度依赖)
// 物理依据: 古丽娜孜等 2025 D2 高密度棉田叶片有效期 110-115 天 (上沿)
//
// ★ 第六轮修正 (2022年型气候专项标定):
//   2022 偏凉多云年: 全期日照率46.6% vs 2025年69.9%, 铃开期≤30%日照天数22天(vs 2025年仅1天)
//   低辐射 → 低光氧化胁迫 → 叶绿体降解慢 → 叶片功能期延长 (Constable & Rawson 1980; Wright 1999)
//   批次三结果: DAE=138 GRO LAI=0.920 vs 实测1.860 (-50.5%), 铃开期nRMSE=36.9% (Poor)
//   根因: LEAF_FUNC_PERIOD=92 过短 → 大量中层叶(age≥92d)过早降至0.10地板值 → GroIMP LAI提前塌陷
//   修正: 92→105 天 (+13天, +14.1%), 参照文献低辐射延长5-15%取中值
//   2025实验组: LEAF_FUNC_PERIOD=95天不变(高辐射晴朗年已精确标定)
//   线性衰退窗口: 105-82=23天 (2025: 95-78=17天, 多云年窗口更宽, 物理合理)
const int LEAF_FUNC_PERIOD = 115;  // 2022标定年: 沿用品种基准值(非自由参数; 年型差异由rad_buffer机制吸收, 与cotton2k_daily.py方法学一致)
