static float c2k_height = 0;   // C2K 株高预测

// 光合权威性分离 — GroIMP 3D 光合才是权威值, Python 的 Beer-Lambert 只作诊断
static float c2k_pyGrossPhoto_diag = 0;   // Python 传来的 grossPhoto (诊断用, 不驱动碳平衡)
static float c2k_pyNetPhoto_diag   = 0;   // Python 传来的 netPhoto (诊断用, 不驱动碳平衡)
