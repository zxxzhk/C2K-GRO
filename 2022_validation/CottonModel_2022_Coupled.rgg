static float c2k_leafGrowthRate = 0;   // 日叶生长速率 → 传给GroIMP调节新叶
static float c2k_bollGrowthRate = 0;   // 日铃增重速率 → 传给GroIMP调节铃重
// 脱落追踪 (供Python日志记录)
static int shed_count_today = 0;   // 当天脱落数
