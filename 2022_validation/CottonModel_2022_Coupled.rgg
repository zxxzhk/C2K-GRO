const float GDD_BRANCH_DELAY      = 165.0f;   // 修正 校准公式遗漏 0.92 系数
const int   GDD_BRANCH_DELAY_FROM = 4;   // 保留

// B. 主茎形态
const int MAX_MAIN_NODES = 17;   // 恢复原值,增节未生效(打顶Day68前17节已全部创建), 反而扰乱偏差计算
const float PLANT_HEIGHT_TARGET = 0.8193;   // 2022标定年: 15点实测直接逻辑斯谛拟合上限(81.93cm, RMSE=2.77cm,
                                             // 与cotton2k_daily.py/cotton2k_standalone_2022.py同步; 与碳路径无关可独立标定)
                                             // 注: 下方c2kCalcHeight()的k/t50形状参数未随本次标定调整(需GroIMP实跑验证), 建议后续按需微调
                                             // 注: 2022年实测矮0.5-1cm, 差异由2022偏凉GDD/化控年型响应决定
const float STEM_DIAMETER_BASE = 0.0110;   // 改-TRAIT: 实测茎粗: 铃期11.04mm, 吐絮期11.18mm;
                                             // 整株均值10.43±0.26mm; 基部取11.0mm
const float STEM_DIAMETER_TOP = 0.0055;   // 改-TRAIT: 同步上调顶部茎粗至5.5mm (保持梯度比例)
const float RICHARDS_K = 0.15;
const float RICHARDS_T0 = 120;

// C. 果枝系统
const int FIRST_FRUIT_NODE = 6;
// (删除脱落模块后的确定性果枝数) ★★★
// ────────────────────────────────────────────────────────────────────
// 旧值, 含脱落): 12 果枝 × 2 位 = 24 候选, 通过随机脱落筛选至 ~7 铃
// 新值, 无脱落): 8 果枝 × 1 位 = 8 候选, 100% 成铃 = 8 铃 (确定性)
// 实测依据 (吐絮率与铃重.xlsx, 4区 n=10株, 综合均值):
// 区一: 9.2 铃/株; 区二: 7.2 铃/株; 综合均值: 8.2 铃/株 (区间 6-12)
// 用户指定: "平均一株是8个棉铃, 包括吐絮和未吐絮的"
// 生物依据: 8 果枝节位 = N6 (FIRST_FRUIT_NODE) ~ N13 (打顶后实测 9-10 果枝)
// 内位 (pos=0) 是高光位, 着蕾成功率高, 取消脱落后 100% 成铃合理
// 论文表述: "Following Section X.X (removal of the stochastic abscission
// module), the fruiting architecture was simplified to a
// deterministic 8 fruit branches × 1 inner position configuration,
// matching the cross-plot field mean of 8.2 bolls/plant (range 6-12,
// n=10 plants over 4 plots, harvest 2025)."
// ────────────────────────────────────────────────────────────────────
const int MAX_FRUIT_BRANCHES = 8;   // (删除脱落, 确定性 8 铃/株)
                                             // 历史保留作脱落模块的候选数; 改为确定性目标
                                             // 生物意义: N6~N13 高光位果枝, 顶端被打顶切除
const int MAX_FRUIT_POS = 1;   // (仅内位 pos=0 着蕾, 取消中位 pos=1)
                                         // ──────────────────────────────────────────────────
                                         // 生物学依据 (塔河2号, 新疆阿拉尔高密度栽培):
                                         // 每台果枝实际具有2~3个潜在果节位 (Mauney 1984; Kerby 1994)
                                         // pos=0 (内位/第1节位): 高光位, 着蕾成功率高
                                         // pos=1 (中位/第2节位): 处于冠层下部, 因光竞争脱落率极高
                                         // 高密度(22万/hm²)下pos=1绝大部分脱落, 与田间观察一致
                                         // 脱落概率分析 (calcShedProb内的fruitPos权重):
                                         // pos=0: prob × 0.35 (内位保护) → daily≈0.020/d → 25d累积≈40%
                                         // pos=1: prob × 1.60 (中位惩罚) → daily≈0.091/d → 上限0.5/d → ~100%脱落
                                         // 结论: pos=1候选几乎全部脱落(光竞争败出), 但参与概率计算路径
                                         // 候选数与结铃预测 (MAX_FRUIT_BRANCHES=12, MAX_FRUIT_POS=2):
                                         // 总候选: 12×2 = 24个
                                         // pos=0存活: 12×(1-0.40) ≈ 7.2铃 → 7铃 ∈ 实测7.07±0.59 ✓
                                         // pos=1存活: 12×(1-~1.0) ≈ 0铃 (高密度下全脱落)
                                         // 最终结铃: ≈7个 ∈ CI [6.40, 7.74] ✓
                                         // 脱落率报告口径 (论文):
                                         // "内位候选脱落率" = nPos0Shed/12 ≈ 40% ∈ [40%,50%] ✓
                                         // (与古丽娜孜等2025文献口径一致: 分母为内位候选)
                                         // 总体脱落率(含pos=1) = totalShed/24 ≈ 70% (不作为主报告指标)
                                         // MAX_FRUIT_POS=3 → 候选27个, 结铃12个(过多), 内位脱落55% ✗
                                         // MAX_FRUIT_POS=2 → 候选24个, pos=1几乎全脱, 结铃7个 ✓
                                         // 关键差异:中pos=1的高脱落率(×1.60×shedFactor)使其作为
                                         // "虚拟候选"参与随机路径而不贡献实质结铃
                                         // 叶片: pos=1新增叶使用leafType=2(外叶38cm²), 防止LAI过高
const float FRUIT_INTERNODE_BASE = 0.068;
const float BRANCH_ANGLE_BASE = 65;
const float BRANCH_ANGLE_MID = 55;
const float BRANCH_ANGLE_TOP = 45;

