// H. 脱落: 基础值由C2K源库比动态调节)
const float SQUARE_SHED_BASE = 0.040;   // (-16.7%) //: 0.055→0.048 (-12.7%, 修复 首跑 58.3% 过冲)
                                            // 文献口径: 古丽娜孜等2025, D2=22万株/hm², 均值48%
                                            // 文献口径: 古丽娜孜等2025, D2=22万株/hm², 均值48%
const float YOUNG_BOLL_SHED_BASE = 0.017;   // (与 SQUARE_SHED_BASE 同比例下调 ~15%)
                                            // 同步下调, 维持三基础脱落比例稳定
                                            // daily@SF=1.10 = 0.017×0.35×1.10×1.075 = 0.00704/d
                                            // GDD<200 窗口(≈10天) 累积 = 6.8%/候选 (耦合模式)
                                            // 配合 SQUARE_SHED_BASE 修正, 总脱落率维持 [40%, 50%]
const float BRANCH_PENALTY_COEF = 0.12;   // 保留, 高台惩罚温和
const float TEMP_SHED_THRESHOLD = 35.0;   // °C 回退, 避免7-8月频繁激活
const float TEMP_SHED_FACTOR = 0.002;   // 旧加法系数, 已废弃 — 仅供历史对比保留
const float TEMP_SHED_FACTOR_MULT = 0.030;   // 乘法高温系数 (per °C above threshold)

// PATCH-2 (Plan-A): 花期脱落基础概率
// 依据: Heitholt 1993 棉花花脱落 3-8%/批次; Ritchie et al. 2007 Cotton Growth and Development
// 一朵花的"可脱落窗口"是 age 24-48h (即本 patch 新增规则触发的单日步),
// 内位×0.35=0.0077/d, 配合蕾+幼铃脱落使总脱落率保持在14-18%
const float FLOWER_SHED_BASE = 0.022;   // (-21.4%) //: 0.032→0.028 (与 SQUARE/YOUNG_BOLL 同比例下调)
// I. 管理
static float chemicalControl = 0.3;
static float plantDensity = 13333;   // 13333株/亩 = 20万株/hm² (一膜六行20万株密度)
// 地块面积换算 (GB/T 28415-2012, 中国法定值)
const float MU_TO_M2 = 666.667f;   // 1 市亩 = 666.667 m² (原代码 667 近似)
const float HA_TO_M2 = 10000.0f;   // 1 ha = 10 000 m²
